# Gatekeeper agent environment. Copy to .env for local runs (or set the
# same names in the Vercel project settings). NEVER commit real values.

# Platform HMAC secret — from the Agent Games dashboard, "Rotate Secret"
# (revealed once; shown as AGENT_GAMES_HMAC_SECRET there). Either name is
# accepted; AGENT_GAMES_SECRET takes precedence if both are set.
AGENT_GAMES_SECRET=
AGENT_GAMES_HMAC_SECRET=

# Kurier mainnet API key (https://kurier.xyz). Leave blank to force
# DRY_RUN mode: proofs are generated and returned, but nothing is
# submitted on-chain and proof_tx is a "dry-run:..." placeholder.
KURIER_API_KEY=
KURIER_DRY_RUN=

# --- Optional tuning (defaults shown in comments) ---
# PORT=3000
# CIRCUITS_DIR=./circuits
# SEEN_STORE_PATH=./data/seen.json
# KURIER_BASE_URL=https://api.kurier.xyz/api/v1
# KURIER_CURVE=bn128
# KURIER_POLL_BUDGET_MS=10000   (early-return cap: poll only until the job
#                               first reports a txHash, never to Finalized)
# KURIER_POLL_BUDGET_COMPETITION_MS=30000  (scored rounds only: the 10 s
#                               cap let proof_tx fall back to a jobId when
#                               Kurier was slow under round-time load, and
#                               Round 3 then failed 0/8 proofs; see
#                               PHASE4.md "Phase 4d")
# KURIER_POLL_INTERVAL_MS=2000
# RESPONSE_DEADLINE_MS=55000
# TASKID_MODE=sha256
# AGENT_GAMES_HMAC_ALG=sha256
# AGENT_GAMES_HMAC_SIG_ENCODING=hex
# AGENT_GAMES_SECRET_FORMAT=raw
